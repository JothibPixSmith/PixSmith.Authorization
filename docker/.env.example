# Copy to the repository root as `.env` — Compose reads it from there automatically.
#
#   cp docker/.env.example .env
#
# `.env` is gitignored. Never commit real credentials.

# ── PostgreSQL superuser (administration only) ───────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser
POSTGRES_DB=pixsmith_auth

# ── Application role (what the auth server connects as) ──────────────────────
# Created on first initialisation by docker/postgres/init/01-create-app-role.sh.
# Use a different password from the superuser — sharing them makes the
# least-privilege role pointless.
APP_DB_USER=pixsmith_app
APP_DB_PASSWORD=change-me-app

# ── Auth server ──────────────────────────────────────────────────────────────
# The URL users actually type in the browser. Must match the redirect URIs
# registered for the Blazor client or OIDC sign-in will fail.
AUTH_BASE_URI=http://localhost:8080

# Rotate before any real deployment — the seeded default is public knowledge.
M2M_CLIENT_SECRET=change-me-m2m-secret

# ── Initial admin account ────────────────────────────────────────────────────
# Seeded only when the database has no users at all, so these cannot be used to
# mint extra accounts on a live system. Read by debug/start.sh.
ADMIN_SEED_EMAIL=admin@pixsmith.local
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=change-me-Admin1234!

# Host port for Postgres. Only needed if you want to connect from the host with
# psql or a GUI; the auth server reaches it over the Docker network regardless.
POSTGRES_HOST_PORT=5432

# ── Docker network ───────────────────────────────────────────────────────────
# Both services join this network; it is how the auth server resolves the
# hostname `postgres`. Change the name to share a network with a reverse proxy
# or other stacks.
DOCKER_NETWORK_NAME=pixsmith-authorization

# Set to true when the network already exists — e.g. you ran
# `docker network create pixsmith-authorization` to start Postgres standalone.
# Leaving this false while the network exists makes `docker compose up` fail,
# because Compose refuses to adopt a network it did not label.
DOCKER_NETWORK_EXTERNAL=false
