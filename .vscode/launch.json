{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Auth Server (API)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: AuthServer.API",
      "program": "${workspaceFolder}/src/AuthServer/AuthServer.API/bin/Debug/net10.0/PixSmith.Authorization.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/AuthServer/AuthServer.API",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      // Starts the whole stack (Postgres + server in containers) via the
      // preLaunchTask, then attaches automatically — no process picker.
      //
      // processId is pinned to 1 because the image uses an exec-form ENTRYPOINT
      // (["dotnet", "PixSmith.Authorization.API.dll"]), so the app is always PID 1
      // with no shell wrapper in between. debug/start.sh asserts this before
      // reporting ready, and fails loudly if it ever stops being true.
      "name": "Attach to Auth Server (container)",
      "type": "coreclr",
      "request": "attach",
      "preLaunchTask": "debug: start container stack",
      "processId": "1",
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": ["exec", "-i", "pixsmith-authserver-debug"],
        "debuggerPath": "/vsdbg/vsdbg",
        "pipeCwd": "${workspaceFolder}",
        "quoteArgs": false
      },
      // PDBs record the container build path (/src); map it back to the repo so
      // breakpoints bind to the files open in the editor.
      "sourceFileMap": {
        "/src": "${workspaceFolder}"
      },
      "justMyCode": true,
      "requireExactSource": false
    }
  ]
}
