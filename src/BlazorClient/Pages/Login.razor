@page "/login"
@inject NavigationManager Nav

@*
    Kept as a route because existing links and bookmarks point at /login, but it no longer
    collects anything: credentials are entered on the server's own login page, reached through
    the authorization-code redirect. This just starts that redirect.
*@

<PageTitle>Signing in…</PageTitle>
<LoadingSpinner />

@code {
    protected override void OnInitialized() =>
        Nav.NavigateTo("authentication/login", forceLoad: false);
}
