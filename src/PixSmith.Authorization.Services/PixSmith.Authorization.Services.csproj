<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PixSmith.Authorization.DataContext\PixSmith.Authorization.DataContext.csproj" />
    <ProjectReference Include="..\PixSmith.Authorization.Repositories\PixSmith.Authorization.Repositories.csproj" />
    <ProjectReference Include="..\AuthServer\AuthServer.Domain\PixSmith.Authorization.Domain.csproj" />
    <ProjectReference Include="..\AuthServer\AuthServer.Infrastructure\PixSmith.Authorization.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The breached-password list CommonPasswordValidator checks (ASVS 6.2.4). Embedded, so
         it travels with the assembly and is present in tests and containers without a copy
         step; LogicalName is pinned so moving the file cannot silently empty the list. -->
    <EmbeddedResource Include="Security/common-passwords.txt"
                      LogicalName="PixSmith.Authorization.Services.CommonPasswords.txt" />
  </ItemGroup>

</Project>
