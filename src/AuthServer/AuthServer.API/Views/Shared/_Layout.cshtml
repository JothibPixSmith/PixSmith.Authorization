@*
    Layout for the server-rendered auth pages (login, access denied).

    Styles are served locally from /css/auth.css. These pages used to load
    https://cdn.tailwindcss.com, which put a third-party script with no subresource
    integrity on the page where users type their password. They now load no JavaScript
    at all, which is what lets SecurityHeaders send `script-src 'none'` for these paths.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Sign In") - AuthServer</title>
    <base href="/" />
    <link rel="stylesheet" href="~/css/auth.css" />
    <link rel="icon" type="image/png" href="~/favicon.png" />
</head>
<body class="bg-gray-50">
    <main class="min-h-screen flex items-center justify-center px-4">
        @RenderBody()
    </main>
</body>
</html>
